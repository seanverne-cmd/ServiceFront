# ServiceFront environment template.
# Copy to .env (git-ignored) and fill in. Every value here is SERVER-SIDE ONLY.
# ---------------------------------------------------------------------------
# SECURITY: never put a service-role key, database password or LLM API key in a
# NEXT_PUBLIC_* variable, in client components, or in anything that ships to a browser.
# The only value the browser may see is NEXT_PUBLIC_WIDGET_ORIGIN (a public URL).
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# What the application connects as. RLS is enforced for this role, so it can only ever
# see the tenant that the current session's context points at.
# Local dev: run scripts/bootstrap-db.sh first.
DATABASE_URL=postgresql://servicefront_app:servicefront_app@127.0.0.1:5432/servicefront_dev

# Migrations, seed and tests only. This role owns the schema and can bypass RLS.
# NEVER give this URL to the running app, to a browser, or to a customer.
# On hosted Supabase this is the "service role" / direct `postgres` connection string.
MIGRATION_DATABASE_URL=postgresql://servicefront_owner:servicefront_owner@127.0.0.1:5432/servicefront_dev

# --- Sessions / auth -------------------------------------------------------
# Signs dashboard session cookies and widget visitor tokens. Server-side only.
# Generate with: openssl rand -hex 32   (32+ characters; required in production)
SESSION_SECRET=

# Hosted auth (Supabase Auth or equivalent) — used to verify dashboard sign-ins.
# AUTH_ISSUER_URL=https://<project-ref>.supabase.co/auth/v1
# AUTH_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Public widget ---------------------------------------------------------
# The origin allowed to embed the chat widget and post to the widget endpoints.
# This is public information (it appears in the customer's page source).
PUBLIC_WIDGET_ORIGIN=http://localhost:3100

# --- AI provider (future) --------------------------------------------------
# No paid service is required to run or demo the app. When DEMO_MODE=true the platform
# answers from the business's own approved facts with a deterministic, clearly labelled
# "demo mode" response and never claims to be a live model answer.
DEMO_MODE=true
LLM_PROVIDER=
# Server-only API key. Must never be exposed to the browser or committed.
LLM_API_KEY=
LLM_MODEL=

# --- Logging ---------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
